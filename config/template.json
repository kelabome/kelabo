        "mcpPrefix": "kelabo/dev/mcp/",
        "cloudflareRealtime": "kelabo/dev/cloudflare-realtime"
      },
      "rtc": {
        "provider": "cloudflare",
        "defaultMode": "sfu",
        "meshMaxParticipants": 5,
        "iceTtlSeconds": 3600,
        "video": true
      },
      "auth": {
        "sessionTtlSeconds": 3600,
        "refreshTtlDays": 60,
        "participantTtlSeconds": 43200,
        "agentTokenTtlDays": 90,
        "socialProviders": []
      },
      "llm": {
        "provider": "deepseek",
        "model": "deepseek-v4-flash",
