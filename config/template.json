          "deepgram": { "model": "nova-3", "diarizeModel": "latest", "tokenTtlSeconds": 60 },
          "soniox": {
            "model": "stt-rt-v5",
            "tokenTtlSeconds": 600,
            "maxSessionSeconds": 14400,
            "endpointDetection": true,
            "maxEndpointDelayMs": 1500,
            "endpointLatencyLevel": 2,
            "endpointSensitivity": 0.3
          }
        }
      },
      "allowIps": [],
