    "dev": {
      "endpoint": "dev",
      "baseDomain": "example.com",
      "account": "123456789012",
      "region": "ap-southeast-2",
      "hostedZone": {
        "name": "dev.example.com",
        "id": "ZXXXXXXXXXXXXX"
      },
      "subdomains": {
        "portal": "dev",
