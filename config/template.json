      },
      "ses": {
        "hostedZone": {
          "name": "example.com",
          "id": "ZXXXXXXXXXXXXX"
        }
      },
      "gateway": {
        "cpu": 512,
        "memoryMiB": 1024,
        "desiredCount": 1,
        "imageTag": "latest",
        "agent": {
          "maxConcurrentRuns": 4,
          "maxDispatchPerTurn": 3,
          "sensitivity": "medium",
          "maxContributionsPerMinute": 3,
          "cooldownSeconds": 45,
          "rollingWindowSize": 60,
          "turnTimeoutSeconds": 1
        }
      },
      "otp": {
        "ttlSeconds": 600,
        "maxAttempts": 5,
        "resendSeconds": 30,
        "perEmailWindowSeconds": 3600,
        "perEmailMaxRequests": 5,
        "perIpWindowSeconds": 3600,
        "perIpMaxRequests": 30
      },
      "retentionDays": 30,
      "_logRetentionDays": "optional: how long CloudWatch keeps Lambda + Gateway application logs. Default 120. Must be a value CloudWatch accepts (1,3,5,7,14,30,60,90,120,150,180,365,...). These logs name the identity performing each action, so this is a privacy setting, not only a cost one."
